# Chép file này thành .env rồi điền giá trị. .env đã nằm trong .gitignore — không bao giờ commit.

# Token GitHub loại fine-grained, chỉ cần quyền đọc public (Public repositories: read-only).
# Tạo tại: https://github.com/settings/personal-access-tokens/new
# Để trống vẫn chạy được nhưng GitHub chỉ cho 10 lần tìm kiếm/phút thay vì 30.
GITHUB_TOKEN=

# Chế độ phát triển (xem nợ D-001 trong DEBT.md). Chỉ đặt false khi đã có máy chủ thật.
DJANGO_DEBUG=true

# Bắt buộc khi DJANGO_DEBUG=false. Khi DEBUG=true, để trống thì mỗi lần chạy tự sinh khoá ngẫu nhiên.
DJANGO_SECRET_KEY=
